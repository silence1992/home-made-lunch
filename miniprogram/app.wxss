/**app.wxss**/
page {
  background-color: #FFF5EE;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用样式 */
.container {
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 154, 118, 0.1);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF9A76;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #FF9A76, #FECDA6);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 118, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #fff;
  color: #FF9A76;
  border: 2rpx solid #FF9A76;
  border-radius: 40rpx;
  padding: 18rpx 38rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-secondary::after {
  border: none;
}

.btn-danger {
  background: #ff6b6b;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-danger::after {
  border: none;
}

.btn-small {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  display: inline-block;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.text-warm {
  color: #FF9A76;
}

.text-center {
  text-align: center;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tag {
  display: inline-block;
  background: #FFF0E6;
  color: #FF9A76;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.tag-default {
  background: #E8F5E9;
  color: #4CAF50;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #ccc;
  font-size: 28rpx;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

/* 星级评分 */
.stars {
  display: flex;
  flex-direction: row;
}

.star {
  font-size: 40rpx;
  margin-right: 8rpx;
}

.star-active {
  color: #FFD700;
}

.star-inactive {
  color: #ddd;
}

/* 输入框 */
.input-box {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFF0E6;
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFF0E6;
}

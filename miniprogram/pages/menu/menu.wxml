<!--食谱管理页-->
<view class="container">
  <!-- 周切换 -->
  <view class="week-nav card">
    <text class="nav-btn" bindtap="prevWeek">‹ 上周</text>
    <text class="nav-current" bindtap="thisWeek">本周</text>
    <text class="nav-btn" bindtap="nextWeek">下周 ›</text>
  </view>

  <view wx:if="{{loading}}" class="empty-tip">加载中...</view>

  <!-- 每日食谱 -->
  <view wx:for="{{weeklyMenu}}" wx:key="date" class="card day-card {{item.isToday ? 'today-card' : ''}}">
    <view class="day-header">
      <view class="day-info">
        <text class="day-week">{{item.dayOfWeek}}</text>
        <text class="day-date">{{item.date}}</text>
        <text wx:if="{{item.isToday}}" class="today-badge">今天</text>
      </view>
      <view class="day-actions">
        <text class="action-link" data-date="{{item.date}}" bindtap="viewLogs">记录</text>
        <text class="action-link add-link" data-date="{{item.date}}" data-label="{{item.dayOfWeek}} {{item.date}}" bindtap="showPicker">+ 添加</text>
      </view>
    </view>

    <view class="day-recipes">
      <view wx:for="{{item.recipes}}" wx:for-item="recipe" wx:key="recipeId" class="recipe-item">
        <view class="recipe-left">
          <text class="recipe-dot {{recipe.isDefault ? 'dot-default' : 'dot-normal'}}">●</text>
          <text class="recipe-name-text">{{recipe.recipeName}}</text>
          <view class="recipe-tag-list">
            <text wx:for="{{recipe.tags}}" wx:for-item="tag" wx:key="*this" class="mini-tag">{{tag}}</text>
          </view>
        </view>
        <text wx:if="{{!recipe.isDefault || !item.isDefaultMenu}}" class="remove-btn" 
              data-date="{{item.date}}" data-recipeid="{{recipe.recipeId}}" 
              data-recipename="{{recipe.recipeName}}" bindtap="removeRecipe">✕</text>
      </view>
    </view>
  </view>

  <!-- 菜谱选择弹窗 -->
  <view wx:if="{{showRecipePicker}}" class="modal-mask" bindtap="hidePicker">
    <view class="modal-content picker-content" catchtap="">
      <view class="modal-title">选择菜谱 · {{selectedDateLabel}}</view>
      <scroll-view scroll-y class="recipe-scroll">
        <view wx:for="{{recipes}}" wx:key="id" class="picker-item" 
              data-recipeid="{{item.id}}" bindtap="addRecipe">
          <text class="picker-name">{{item.name}}</text>
          <text wx:if="{{item.isDefault}}" class="tag tag-default" style="font-size:20rpx">默认</text>
          <text wx:if="{{item.description}}" class="picker-desc text-muted">{{item.description}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

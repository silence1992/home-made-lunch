.week-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
}

.nav-btn {
  color: #FF9A76;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
}

.nav-current {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.day-card {
  padding: 24rpx 30rpx;
}

.today-card {
  border-left: 6rpx solid #FF9A76;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.day-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.day-week {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.day-date {
  font-size: 24rpx;
  color: #999;
}

.today-badge {
  background: #FF9A76;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.day-actions {
  display: flex;
  gap: 20rpx;
}

.action-link {
  font-size: 24rpx;
  color: #999;
}

.add-link {
  color: #FF9A76;
  font-weight: 500;
}

.day-recipes {
  padding: 0;
}

.recipe-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.recipe-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.recipe-dot {
  font-size: 16rpx;
  margin-right: 8rpx;
}

.dot-default {
  color: #4CAF50;
}

.dot-normal {
  color: #FF9A76;
}

.recipe-name-text {
  font-size: 28rpx;
}

.recipe-tag-list {
  display: flex;
  gap: 6rpx;
}

.mini-tag {
  font-size: 18rpx;
  background: #FFF0E6;
  color: #FF9A76;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.remove-btn {
  color: #ccc;
  font-size: 28rpx;
  padding: 10rpx;
}

.picker-content {
  max-height: 70vh;
}

.recipe-scroll {
  max-height: 50vh;
}

.picker-item {
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.picker-item:active {
  background: #FFF5EE;
}

.picker-name {
  font-size: 30rpx;
  font-weight: 500;
}

.picker-desc {
  width: 100%;
  font-size: 22rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  margin-bottom: 30rpx;
}

.family-header {
  display: flex;
  align-items: center;
}

.family-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.family-info {
  display: flex;
  flex-direction: column;
}

.family-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.member-list {
  padding: 0;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.member-item:last-child {
  border-bottom: none;
}

.member-info {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
}

.member-role {
  margin-top: 4rpx;
}

.role-group {
  display: flex;
  margin-top: 16rpx;
}

.role-option {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 28rpx;
}

.invite-result {
  text-align: center;
  padding: 20rpx;
  background: #FFF5EE;
  border-radius: 12rpx;
}

.invite-code {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF9A76;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

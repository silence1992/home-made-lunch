.greeting-card {
  background: linear-gradient(135deg, #FF9A76, #FECDA6);
  color: #fff;
}

.greeting-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.greeting-emoji {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.greeting-info {
  display: flex;
  flex-direction: column;
}

.greeting-name {
  font-size: 36rpx;
  font-weight: bold;
}

.greeting-date {
  font-size: 24rpx;
  opacity: 0.9;
}

.greeting-text {
  font-size: 30rpx;
  line-height: 1.8;
  padding: 10rpx 0;
}

.menu-list {
  padding: 10rpx 0;
}

.menu-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 500;
}

.menu-tags {
  margin-top: 8rpx;
}

.feedback-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #666;
}

.hint-text {
  font-size: 28rpx;
  color: #FF9A76;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.quick-links {
  display: flex;
  justify-content: space-around;
  padding: 10rpx 0;
}

.quick-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.quick-text {
  font-size: 24rpx;
  color: #666;
}

<!--首页-->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="empty-tip">
    <text>加载中...</text>
  </view>

  <block wx:elif="{{greeting}}">
    <!-- 问候卡片 -->
    <view class="card greeting-card">
      <view class="greeting-header">
        <text class="greeting-emoji">🍱</text>
        <view class="greeting-info">
          <text class="greeting-name">{{greeting.nickname}}</text>
          <text class="greeting-date">{{greeting.today}}</text>
        </view>
      </view>
      <view class="greeting-text">{{greeting.greeting}}</view>
    </view>

    <!-- 未加入家庭提示 -->
    <view wx:if="{{!greeting.hasFamily}}" class="card text-center">
      <view class="empty-tip">还没有加入家庭哦~</view>
      <button class="btn-primary" bindtap="goToFamily">去创建/加入家庭</button>
    </view>

    <!-- 今日菜谱（厨师/管理员视角） -->
    <view wx:if="{{greeting.todayMenu && (greeting.role === 'COOK' || greeting.role === 'ADMIN')}}" class="card">
      <view class="card-title">🍳 今日菜谱</view>
      <view class="menu-list">
        <view wx:for="{{greeting.todayMenu}}" wx:key="recipeId" class="menu-item">
          <text class="menu-name {{item.isDefault ? 'text-warm' : ''}}">{{item.recipeName}}</text>
          <view class="menu-tags">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 评价反馈（厨师视角） -->
    <view wx:if="{{greeting.ratingFeedback}}" class="card">
      <view class="card-title">📊 最近反馈</view>
      <view class="feedback-text">{{greeting.ratingFeedback}}</view>
      <view class="feedback-stats text-muted mt-20">
        <text>近期平均评分: {{greeting.avgRating}}星 ({{greeting.recentRatingCount}}条评价)</text>
      </view>
    </view>

    <!-- 明日菜谱 -->
    <view wx:if="{{greeting.tomorrowMenu}}" class="card">
      <view class="card-title">📅 明日菜谱 · {{greeting.tomorrowDate}}</view>
      <view wx:if="{{greeting.tomorrowHint}}" class="hint-text">{{greeting.tomorrowHint}}</view>
      <view class="menu-list">
        <view wx:for="{{greeting.tomorrowMenu}}" wx:key="recipeId" class="menu-item">
          <text class="menu-name {{item.isDefault ? 'text-warm' : ''}}">{{item.recipeName}}</text>
        </view>
      </view>
      <button class="btn-secondary btn-small mt-20" bindtap="goToMenu">管理食谱</button>
    </view>

    <!-- 评价入口（就餐者14点后） -->
    <view wx:if="{{greeting.canRate}}" class="card">
      <view class="card-title">⭐ 今日评价</view>
      <view wx:if="{{greeting.hasRated}}" class="text-muted">
        你已经评价过啦~ 可以修改评价哦
      </view>
      <view wx:else class="text-muted">
        还没有评价，快来给厨师打个分吧~
      </view>
      <button class="btn-primary btn-small mt-20" bindtap="goToRating">
        {{greeting.hasRated ? '修改评价' : '去评价'}}
      </button>
    </view>

    <!-- 快捷入口 -->
    <view class="card" wx:if="{{greeting.hasFamily}}">
      <view class="card-title">🔗 快捷入口</view>
      <view class="quick-links">
        <view class="quick-link" bindtap="goToMenu">
          <text class="quick-icon">📋</text>
          <text class="quick-text">本周食谱</text>
        </view>
        <view class="quick-link" bindtap="goToLogs">
          <text class="quick-icon">📝</text>
          <text class="quick-text">操作记录</text>
        </view>
      </view>
    </view>
  </block>
</view>

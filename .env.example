# ============================================================
# 环境变量配置模板
# 使用方法：复制此文件为 .env 并填入真实值
#   cp .env.example .env
# 注意：.env 文件包含敏感信息，已加入 .gitignore，不会提交到仓库
# ============================================================

# 服务端口
SERVER_PORT=8080

# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/home_made_lunch?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password

# 微信小程序配置
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# 日志级别（可选值：debug, info, warn, error）
LOG_LEVEL=info
